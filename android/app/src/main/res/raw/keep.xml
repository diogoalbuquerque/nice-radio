<?xml version="1.0" encoding="utf-8"?>
<!--
  Also keeps ic_shortcut_play, the long-press shortcut's icon, which
  quick_actions looks up by string name (getIdentifier) — same problem.

  Stops Android's release-build resource shrinker from deleting the
  audio_service package's notification icons (audio_service_play_arrow,
  _pause, _stop, etc). audio_service refers to them only by string name
  from Dart (see MediaControl.androidIcon in package:audio_service), so
  the shrinker's static analysis never sees them "used" and strips them
  from release APKs — this crashed the lock-screen/notification controls
  on Android release builds with "You must specify an icon resource id
  to build a CustomAction" the moment playback started, caught by
  actually running a release build on an emulator. Debug builds don't shrink resources, so
  this was invisible until then.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_shortcut_play" />
